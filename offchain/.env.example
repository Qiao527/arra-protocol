# Arc testnet
RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002
VAULT_ADDRESS=0x...            # from forge script output
OPERATOR_PRIVATE_KEY=0x...     # signs quotes, records hedges. Testnet-only key!
SETTLER_PRIVATE_KEYS=0x..,0x..,0x..  # demo only: in production each settler runs separately

# Pricing
HEDGE_BUFFER_BPS=500           # b = 5%
CAPITAL_CHARGE_BPS=200         # r = 2% (on collateral the cover ADDS)
SURCHARGE_K_BPS=2000           # k = 20% convex utilization surcharge at full capacity
QUOTE_TTL_SEC=60
MAX_PROBABILITY=0.5            # refuse covers on likely outcomes

# Gemini
MOCK_GEMINI=false              # true = use the built-in demo market + order book
GEMINI_API_KEY=                # SANDBOX key (Trader role) for the hedger
GEMINI_API_SECRET=
HEDGE_THRESHOLD_USDC=2000

# Review hardening (docs/REVIEW.md)
WS_DEPTH=true                  # real order-book depth from wss://ws.gemini.com (false = modeled ladder)
# IN_GAME_MAX_SEC=7200         # override the per-sport limit for in-game cover after the start
QUICKNODE_WEBHOOK_SECRET=      # REQUIRED for hedger webhook mode (sent as x-arra-secret); unset = 503
# EVIDENCE_DIR=./evidence      # where settlers store the exact Gemini bytes they attest

# Hosted pricer API
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated frontend origins (CORS)
RATE_LIMIT_PER_MIN=60          # per client IP
TRUST_PROXY=0                  # 1 behind one reverse proxy (Render, Fly) so the client IP is right
MAX_PAYOUT_USDC=50000

# zkTLS proofs of Gemini results (Reclaim Builder org token, rorg_...). Optional.
RECLAIM_ORG_TOKEN=
