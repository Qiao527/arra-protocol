{
  "name": "arra-offchain",
  "version": "1.0.0",
  "description": "Arra pricer, hedger and settler services",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "e2e:anvil": "../script/e2e-anvil.sh",
    "pricer": "node src/pricer.js",
    "hedger": "node src/hedger.js",
    "settler": "node src/settler.js watch",
    "settle": "node src/settler.js settle",
    "e2e": "node scripts/e2e-local.js",
    "abi": "node -e \"const fs=require('fs');const a=JSON.parse(fs.readFileSync('../out/ArraVault.sol/ArraVault.json','utf8')).abi;fs.mkdirSync('abi',{recursive:true});fs.writeFileSync('abi/ArraVault.json',JSON.stringify({abi:a},null,1)+'\\\\n')\"",
    "start": "node src/pricer.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "viem": "^2.58.0"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@reclaimprotocol/zk-fetch": "^2.1.0"
  }
}
